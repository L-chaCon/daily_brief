{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "greeting", "focus", "todos", "updates", "schedule_notes", "reading"],
  "properties": {
    "schema": {"const": 1},
    "greeting": {"type": "string", "maxLength": 300},
    "focus": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["title", "body", "item_ids", "prompt"],
         "properties": {
           "title": {"type": "string", "maxLength": 80},
           "body": {"type": "string", "maxLength": 600},
           "item_ids": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}},
           "prompt": {"type": "string", "maxLength": 500}}}
      ]
    },
    "todos": {"type": "array", "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "label", "title", "body"],
      "properties": {
        "item_id": {"type": "string"},
        "label": {"type": "string", "maxLength": 24},
        "title": {"type": "string", "maxLength": 80},
        "body": {"type": "string", "maxLength": 300}}}},
    "updates": {"type": "array", "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["item_ids", "title", "body"],
      "properties": {
        "item_ids": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
        "title": {"type": "string", "maxLength": 80},
        "body": {"type": "string", "maxLength": 400}}}},
    "schedule_notes": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "note", "prep_prompt"],
      "properties": {
        "item_id": {"type": "string"},
        "note": {"type": "string", "maxLength": 200},
        "prep_prompt": {"type": "string", "maxLength": 300}}}},
    "reading": {"type": "array", "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "why"],
      "properties": {
        "item_id": {"type": "string"},
        "why": {"type": "string", "maxLength": 200}}}}
  }
}
